+            ui.label(format!("Chưa nhận: {}",open_count));
+            ui.label("→");
+            ui.label(format!("Đang xử lý: {}",doing_count));
+            ui.label("→");
+            ui.label(format!("Chờ/đã xác nhận: {}",done_count));
